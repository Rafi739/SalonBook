# The Next.js dev server uses port 3000 by default.
BETTER_AUTH_URL=http://localhost:3000

# Express API target. Run the backend with PORT=4000 for this local URL.
BACKEND_API_URL=http://localhost:4000/api

# Required by Better Auth. Generate a unique secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Required MongoDB connection. Replace this safe local development placeholder
# with your own connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017/salonbook
MONGODB_DATABASE=salonbook

# Optional DNS server IPs for MongoDB SRV lookups (leave unset to use system DNS).
# MONGODB_DNS_SERVERS=<DNS_SERVER_IP>[,<DNS_SERVER_IP>...]

# Optional Google sign-in; set both values to enable the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
